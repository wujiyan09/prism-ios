			<key>LSHandlerRank</key><string>Owner</string>
			<key>LSItemContentTypes</key><array><string>com.wujiyan09.prism.paper</string></array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key><string>com.wujiyan09.prism.paper</string>
			<key>UTTypeDescription</key><string>Prism Paper</string>
			<key>UTTypeConformsTo</key><array><string>public.json</string><string>public.data</string></array>
			<key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>prismpaper</string></array></dict>
		</dict>
	</array>
